# LOLIN S2 mini (ESP32-S2FN4R2, single core, 4 MB flash).

# Memory and power: on the S2 every byte of IRAM is taken from the heap, and
# the web server, two UART channels and AP+STA Wi-Fi need that heap (with the
# IRAM options below httpd, DHCP and discovery ran out of memory on hardware).
# 160 MHz is also what this board ran reliably with the ROM USB console, and
# it draws less current on a weak supply.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
# CONFIG_UART_ISR_IN_IRAM is not set
CONFIG_BRIDGE_UART_RX_BUF=4096
CONFIG_BRIDGE_SOC_UART_RX_BUF=4096

# No UART0 pins on the headers: console over the native USB port (ROM CDC).
CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_ESP_CONSOLE_USB_CDC_SUPPORT_ETS_PRINTF=y

# Wiring:
#   MCU UART  (UART1, tcp/2324): TX GPIO35, RX GPIO33
#   SoC shell (UART0, tcp/2323): TX GPIO37, RX GPIO39
#   SWD (tcp/2325, 3335):        SWDIO GPIO16, SWCLK GPIO18
CONFIG_BRIDGE_UART_TX_GPIO=35
CONFIG_BRIDGE_UART_RX_GPIO=33
CONFIG_BRIDGE_SOC_UART_NUM=0
CONFIG_BRIDGE_SOC_UART_TX_GPIO=37
CONFIG_BRIDGE_SOC_UART_RX_GPIO=39
CONFIG_BRIDGE_SWDIO_GPIO=16
CONFIG_BRIDGE_SWCLK_GPIO=18
CONFIG_BRIDGE_LED_GPIO=15
