# LOLIN S2 mini (ESP32-S2FN4R2, single core, 4 MB flash).

# No UART0 pins on the headers: console over the native USB port (ROM CDC).
CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_ESP_CONSOLE_USB_CDC_SUPPORT_ETS_PRINTF=y

# Wiring: UART1 on GPIO35 (ESP TX) / GPIO33 (ESP RX); SWD on GPIO16/18.
CONFIG_BRIDGE_UART_TX_GPIO=35
CONFIG_BRIDGE_UART_RX_GPIO=33
CONFIG_BRIDGE_SWDIO_GPIO=16
CONFIG_BRIDGE_SWCLK_GPIO=18
CONFIG_BRIDGE_LED_GPIO=15
