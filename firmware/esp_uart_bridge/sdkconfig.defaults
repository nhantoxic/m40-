# Settings shared by every target. Chip-specific settings (console, pins,
# buffer sizes, core affinity) are in sdkconfig.defaults.<target>, which
# ESP-IDF applies on top of this file automatically.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Keep the socket responsive; the console is latency-sensitive, not throughput-bound.
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Performance: -O2 instead of -Og, full CPU clock (S2 default is 160 MHz),
# lwIP hot paths in IRAM. The SWD bit-bang delay is computed from the CPU
# clock, so the configured SWD kHz stays the same.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# UART interrupt stays serviceable while flash is busy (NVS writes from the
# app), so the 128-byte RX FIFO cannot overflow during a settings save.
CONFIG_UART_ISR_IN_IRAM=y

# Web app + command API: WebSocket terminal, room for the extra sockets
# (UART/SWD/bitbang listeners + clients, httpd, discovery, mDNS), browser
# request headers, and a 1.5 MB app partition (NVS offset is unchanged, so
# saved settings survive the partition table change).
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_BRIDGE_UART_BAUD=115200
CONFIG_BRIDGE_TCP_PORT=2324
CONFIG_BRIDGE_SWD_CLOCK_KHZ=1000
# CONFIG_BRIDGE_UART_AUTOBAUD is not set
# CONFIG_BRIDGE_UART_EVEN_PARITY is not set
# CONFIG_BRIDGE_MCU_UART_ENABLE is not set
