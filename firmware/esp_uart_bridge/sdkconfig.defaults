# The LOLIN S2 mini has no UART0 pins on its headers, so the console must go
# over the native USB port as CDC. Harmless on the S3 DevKitC (which also has a
# separate UART bridge); override with menuconfig if you prefer UART0 there.
CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_ESP_CONSOLE_USB_CDC_SUPPORT_ETS_PRINTF=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Keep the socket responsive; the console is latency-sensitive, not throughput-bound.
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Performance: -O2 instead of -Og, full CPU clock (S2 default is 160 MHz),
# lwIP hot paths in IRAM. The SWD bit-bang delay is computed from the CPU
# clock, so the configured SWD kHz stays the same.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y

CONFIG_BRIDGE_UART_TX_GPIO=35
CONFIG_BRIDGE_UART_RX_GPIO=33
CONFIG_BRIDGE_UART_BAUD=115200
CONFIG_BRIDGE_TCP_PORT=2324
CONFIG_BRIDGE_SWD_CLOCK_KHZ=1000
# CONFIG_BRIDGE_UART_AUTOBAUD is not set
# CONFIG_BRIDGE_UART_EVEN_PARITY is not set
# CONFIG_BRIDGE_MCU_UART_ENABLE is not set
