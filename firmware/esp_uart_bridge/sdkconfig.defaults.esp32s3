# ESP32-S3-DevKitC-1 (dual core, 512 KB SRAM). Also fits S3 modules on a
# custom board: adjust the pins below.

# The DevKitC "USB" port is the built-in USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Two cores: Wi-Fi and lwIP on core 0; the UART pumps and SWD bit-bang are
# pinned to core 1 in the code (bridge_cores.h).
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# More SRAM: deeper UART ring, larger TCP windows, more Wi-Fi RX buffers.
CONFIG_BRIDGE_UART_RX_BUF=16384
CONFIG_BRIDGE_SOC_UART_RX_BUF=16384
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_BRIDGE_SWD_MAX_READ=16384

# Wiring (all free on the DevKitC-1; GPIO35-37 are taken by octal PSRAM on
# N8R8/N16R8 modules, GPIO43/44 carry ROM boot messages):
#   MCU UART  (UART1, tcp/2324): TX GPIO17, RX GPIO21
#   SoC shell (UART2, tcp/2323): TX GPIO38, RX GPIO39 (GPIO37 is PSRAM on N8R8)
#   SWD: SWDIO GPIO16, SWCLK GPIO18 (same as the S2)
CONFIG_BRIDGE_UART_TX_GPIO=17
CONFIG_BRIDGE_UART_RX_GPIO=21
CONFIG_BRIDGE_SOC_UART_NUM=2
CONFIG_BRIDGE_SOC_UART_TX_GPIO=38
CONFIG_BRIDGE_SOC_UART_RX_GPIO=39
CONFIG_BRIDGE_SWDIO_GPIO=16
CONFIG_BRIDGE_SWCLK_GPIO=18
# The DevKitC LED is an addressable RGB LED (GPIO48), not a plain GPIO LED.
CONFIG_BRIDGE_LED_GPIO=-1
