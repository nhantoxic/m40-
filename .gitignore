# sdkconfig holds the Wi-Fi SSID/password: never commit it.
# Commit changes to sdkconfig.defaults instead.
sdkconfig
sdkconfig.old
sdkconfig.*
!sdkconfig.defaults
!sdkconfig.defaults.esp32*

